# ============================================================================
# dnsd-rs 配置示例（环境变量 / .env）
# ============================================================================

# 运行环境 dev | prod
ENV=dev
# 实例唯一标识（用于审计日志 verifier）
INSTANCE_ID=inst-1

# --- 监听地址 ---
# 传统 DNS（UDP/TCP），开发环境避开 53 端口
DNS_LISTEN_UDP=0.0.0.0:5300
DNS_LISTEN_TCP=0.0.0.0:5300
# DoH（明文 HTTP；生产环境由 nginx 提供 TLS 并反代到本端口）
DOH_LISTEN=0.0.0.0:8053

# --- MySQL 主库（元数据 + 日志 + 审计）---
MYSQL_DSN=mysql://dns:dns@127.0.0.1:3306/dns_platform
MYSQL_MAX_CONNS=32

# --- 三层缓存 ---
# L1：进程内内存缓存
L1_MAX_ENTRIES=131072
L1_TTL_SECS=60
# L2：自建内嵌 KV 库（磁盘持久化）
L2_PATH=data/l2-cache
L2_MAX_BYTES=4294967296
# L3：Redis 备用缓存（留空禁用）
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
# 缓存 TTL 上限 / 负缓存 TTL
CACHE_MAX_TTL=21600
NEG_CACHE_TTL=30

# --- 递归解析 ---
# 自定义根服务器（逗号分隔 ip:port；留空用内置 13 台根）
ROOT_HINTS=
RECURSE_TIMEOUT=10
RECURSE_MAX_DEPTH=12
NS_PROBE_TIMEOUT_MS=2000

# --- 查询日志 / 审计 ---
LOG_BATCH_SIZE=500
LOG_FLUSH_INTERVAL=2

# --- ECS (EDNS Client Subnet) ---
ECS_PASSTHROUGH=true
ECS_SCOPE_MAX=24

# --- IPv6 → IPv4 双栈推导（内网 IPv6 客户端反推公网 IPv4 透传 ECS）---
DUALSTACK_ENABLED=false
# RFC6052 NAT64 前缀，逗号分隔
NAT64_PREFIXES=64:ff9b::/96
# 绑定表 CSV（ipv6_subnet,ipv4[,isp[,region]]），或通过 MySQL dualstack_bindings 表
IPV6_IPV4_MAP_FILE=
# 外部映射 API（{ip} 占位符，HTTP）
IPV6_IPV4_MAP_API_URL=
IPV6_IPV4_MAP_API_TIMEOUT_MS=500
# 推导出的 IPv4 ECS 前缀长度（默认 32）
ECS_DERIVE_MASK=32
# 纯真 qqwry.dat（IPv4 归属地/运营商）与 IPv6 归属 CSV（校验用）
GEO_IPV4_FILE=
GEO_IPV6_FILE=
GEO_STRICT_CITY=false

# --- 限流 ---
RATE_LIMIT_QPS=100

# --- 管理 API ---
API_LISTEN=127.0.0.1:8080
